# 복사해서 .env.local로 저장 (Vercel에서는 Project Settings → Environment Variables)

# 관리자 로그인 비밀번호 (운영에서는 필수)
ADMIN_PASSWORD=
# 세션 쿠키 서명 키 — 32자 이상 임의 문자열 (예: openssl rand -base64 32)
SESSION_SECRET=

# Supabase — 둘 다 있으면 Supabase, 없으면 로컬 파일(data/db.json) 사용
SUPABASE_URL=
# 서버 전용 키. 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# 로컬 파일 저장소 경로 (기본 data/db.json). 데모: data/demo.db.json
# DATA_FILE=data/db.json
